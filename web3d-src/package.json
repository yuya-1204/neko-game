{
  "name": "neko-web3d-collection",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/clean-build-assets.mjs && vite build && node scripts/finalize-service-worker.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run build",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "babylonjs": "9.18.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
